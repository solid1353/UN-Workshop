+    private List<Program> openProjectPrograms(Object consumer, List<Program> acquiredPrograms)
+            throws Exception {
+        List<Program> programs = new ArrayList<>();
+        programs.add(currentProgram);
+        if (state.getProject() == null) {
+            return programs;
+        }
+        collectPrograms(
+            state.getProject().getProjectData().getRootFolder(),
+            consumer,
+            programs,
+            acquiredPrograms);
+        return programs;
+    }
+
+    private void collectPrograms(
+            DomainFolder folder,
+            Object consumer,
+            List<Program> programs,
+            List<Program> acquiredPrograms) throws Exception {
+        for (DomainFile file : folder.getFiles()) {
+            if (file.equals(currentProgram.getDomainFile())) {
+                continue;
+            }
+            DomainObject domainObject = file.getDomainObject(consumer, false, false, monitor);
+            if (domainObject instanceof Program program) {
+                programs.add(program);
+                acquiredPrograms.add(program);
+            } else {
+                domainObject.release(consumer);
+            }
+        }
+        for (DomainFolder child : folder.getFolders()) {
+            collectPrograms(child, consumer, programs, acquiredPrograms);
         }
     }
 
