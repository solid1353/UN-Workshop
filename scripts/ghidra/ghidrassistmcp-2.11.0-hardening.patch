+/*
+ * MCP tool that applies UN Workshop annotations recorded by the router.
+ */
+package ghidrassistmcp.tools;
+
+import java.util.List;
+import java.util.Map;
+
+import ghidra.program.model.listing.Program;
+import ghidrassistmcp.McpTool;
+import ghidrassistmcp.annotations.AnnotationApplier;
+import io.modelcontextprotocol.spec.McpSchema;
+
+/**
+ * Applies type declarations and symbols.tsv rows. The router calls it only after it
+ * has recorded the same annotations in the annotation files.
+ */
+public class ApplyAnnotationsTool implements McpTool {
+
+    @Override
+    public boolean isReadOnly() {
+        return false;
+    }
+
+    @Override
+    public boolean isIdempotent() {
+        return true;
+    }
+
+    @Override
+    public String getName() {
+        return "apply_annotations";
+    }
+
+    @Override
+    public String getDescription() {
+        return "Apply annotation type declarations and symbols.tsv rows";
+    }
+
+    @Override
+    public McpSchema.JsonSchema getInputSchema() {
+        return new McpSchema.JsonSchema("object",
+            Map.of(
+                "types", Map.of("type", "string", "description", "C type declarations"),
+                "symbols", Map.of("type", "string", "description", "symbols.tsv text with its header")
+            ),
+            List.of(), null, null, null);
+    }
+
+    @Override
+    public McpSchema.CallToolResult execute(Map<String, Object> arguments, Program currentProgram) {
+        if (currentProgram == null) {
+            return error("No program currently loaded");
+        }
+        try {
+            Object symbols = arguments.get("symbols");
+            AnnotationApplier.apply(currentProgram, (String) arguments.get("types"),
+                symbols == null ? List.of() : AnnotationApplier.parseSymbols((String) symbols));
+            return McpSchema.CallToolResult.builder().addTextContent("Applied").build();
+        }
+        catch (Exception exception) {
+            return error(exception.getMessage());
+        }
+    }
+
+    private static McpSchema.CallToolResult error(String message) {
+        return McpSchema.CallToolResult.builder().addTextContent(message).isError(true).build();
+    }
+}
