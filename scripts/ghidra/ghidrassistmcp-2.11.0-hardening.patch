new file mode 100644
index 0000000..c54ccb7
--- /dev/null
+++ b/src/main/java/ghidrassistmcp/annotations/AnnotationApplier.java
@@ -0,0 +1,234 @@
+/*
+ * Applies UN Workshop annotations: C type declarations and symbol rows.
+ * The apply_annotations MCP tool uses it.
+ */
+package ghidrassistmcp.annotations;
+
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import ghidra.app.cmd.disassemble.DisassembleCommand;
+import ghidra.app.cmd.function.ApplyFunctionSignatureCmd;
+import ghidra.app.cmd.function.CreateFunctionCmd;
+import ghidra.app.util.cparser.C.CParser;
+import ghidra.app.util.parser.FunctionSignatureParser;
+import ghidra.program.model.address.Address;
+import ghidra.program.model.data.DataType;
+import ghidra.program.model.data.DataTypeManager;
+import ghidra.program.model.data.FunctionDefinitionDataType;
+import ghidra.program.model.listing.CommentType;
+import ghidra.program.model.listing.Data;
+import ghidra.program.model.listing.Function;
+import ghidra.program.model.listing.Program;
+import ghidra.program.model.symbol.SourceType;
+import ghidra.program.model.symbol.Symbol;
+import ghidra.program.model.symbol.SymbolTable;
+import ghidra.program.model.data.DataUtilities;
+import ghidra.util.data.DataTypeParser;
+
+public final class AnnotationApplier {
+
+    /** One row of symbols.tsv. */
+    public record SymbolRow(String address, String kind, String name, String type, String comment) {
+    }
+
+    private AnnotationApplier() {
+    }
+
+    /** Parse symbols.tsv text: a header row, then address, kind, name, type, comment. */
+    public static List<SymbolRow> parseSymbols(String text) {
+        List<SymbolRow> rows = new ArrayList<>();
+        String[] lines = text.replace("\r", "").split("\n");
+        if (lines.length == 0 || !lines[0].equals("address\tkind\tname\ttype\tcomment")) {
+            throw new IllegalArgumentException(
+                "symbols.tsv must start with the header: address, kind, name, type, comment");
+        }
+        for (int index = 1; index < lines.length; index++) {
+            if (lines[index].isEmpty()) {
+                continue;
+            }
+            String[] fields = lines[index].split("\t", -1);
+            if (fields.length != 5) {
+                throw new IllegalArgumentException(
+                    "symbols.tsv line " + (index + 1) + " must have five columns");
+            }
+            rows.add(new SymbolRow(fields[0], fields[1], fields[2], fields[3], fields[4]));
+        }
+        return rows;
+    }
+
+    /** Apply type declarations, then symbol rows, in one transaction; nothing is kept on failure. */
+    public static void apply(Program program, String types, List<SymbolRow> symbols) throws Exception {
+        int transaction = program.startTransaction("Apply annotations");
+        boolean committed = false;
+        try {
+            if (types != null && !types.isBlank()) {
+                applyTypes(program, types);
+            }
+            for (SymbolRow row : symbols) {
+                try {
+                    applySymbol(program, row);
+                }
+                catch (Exception exception) {
+                    throw new IllegalArgumentException(
+                        row.address() + " " + row.name() + ": " + exception.getMessage(), exception);
+                }
+            }
+            committed = true;
+        }
+        finally {
+            program.endTransaction(transaction, committed);
+        }
+    }
+
+    private static void applyTypes(Program program, String types) throws Exception {
+        DataTypeManager manager = program.getDataTypeManager();
+        CParser parser = new CParser(manager, true, null);
+        try {
+            // Register tags and typedef aliases before definitions. Annotation edits can
+            // add a referenced type later in types.h; a fresh project must not depend
+            // on types left behind by previous in-memory applications.
+            String code = types.replaceAll("(?s)/\\*.*?\\*/|//[^\\r\\n]*", " ");
+            Matcher tags = Pattern.compile(
+                "typedef\\s+(struct|union)\\s+(\\w+)\\s*\\{").matcher(code);
+            while (tags.find()) {
+                parser.parse("typedef " + tags.group(1) + " " + tags.group(2)
+                    + " " + tags.group(2) + ";");
+            }
+            List<String> aliases = new ArrayList<>();
+            Matcher typedefs = Pattern.compile(
+                "typedef\\s+[^;{}]+;").matcher(code);
+            while (typedefs.find()) {
+                aliases.add(typedefs.group());
+            }
+            while (!aliases.isEmpty()) {
+                int count = aliases.size();
+                for (var iterator = aliases.iterator(); iterator.hasNext();) {
+                    String declaration = iterator.next();
+                    try {
+                        parser.parse(declaration);
+                        iterator.remove();
+                    }
+                    catch (ghidra.app.util.cparser.C.ParseException exception) {
+                        // A typedef can itself refer to another typedef farther down.
+                    }
+                }
+                if (aliases.size() == count) {
+                    throw new IllegalArgumentException(
+                        "Unresolved annotation typedefs: " + String.join(" ", aliases));
+                }
+            }
+            parser.parse(new ByteArrayInputStream(types.getBytes(StandardCharsets.UTF_8)));
+        }
+        catch (ghidra.app.util.cparser.C.ParseException exception) {
+            throw new IllegalArgumentException("types.h does not parse: " + exception.getMessage());
+        }
+    }
+
+    private static void applySymbol(Program program, SymbolRow row) throws Exception {
+        Address address = program.getAddressFactory().getDefaultAddressSpace()
+            .getAddress(row.address());
+        if (!program.getMemory().contains(address)) {
+            throw new IllegalArgumentException("address is outside program memory");
+        }
+        if (row.name().isEmpty()) {
+            throw new IllegalArgumentException("name is required");
+        }
+        switch (row.kind()) {
+            case "function" -> applyFunction(program, address, row);
+            case "label" -> applyLabel(program, address, row);
+            case "data" -> applyData(program, address, row);
+            default -> throw new IllegalArgumentException(
+                "kind must be function, label, or data: " + row.kind());
+        }
+    }
+
+    private static void applyFunction(Program program, Address address, SymbolRow row) throws Exception {
+        Function function = program.getFunctionManager().getFunctionAt(address);
+        if (function == null) {
+            if (program.getListing().getInstructionAt(address) == null) {
+                new DisassembleCommand(address, null, true).applyTo(program);
+            }
+            if (!new CreateFunctionCmd(address).applyTo(program)) {
+                throw new IllegalArgumentException("no function can be created here");
+            }
+            function = program.getFunctionManager().getFunctionAt(address);
+        }
+        String generated = function.getSymbol().getSource() == SourceType.DEFAULT
+            ? function.getName() : null;
+        function.setName(row.name(), SourceType.USER_DEFINED);
+        keepGeneratedName(program, address, generated);
+        if (!row.type().isEmpty()) {
+            FunctionSignatureParser parser = new FunctionSignatureParser(
+                program.getDataTypeManager(), null);
+            FunctionDefinitionDataType signature = parser.parse(function.getSignature(), row.type());
+            signature.setCallingConvention(
+                program.getCompilerSpec().getDefaultCallingConvention().getName());
+            if (!new ApplyFunctionSignatureCmd(address, signature, SourceType.USER_DEFINED)
+                    .applyTo(program)) {
+                throw new IllegalArgumentException("prototype cannot be applied: " + row.type());
+            }
+            function.setName(row.name(), SourceType.USER_DEFINED);
+        }
+        if (!row.comment().isEmpty()) {
+            program.getListing().setComment(address, CommentType.PLATE, row.comment());
+        }
+    }
+
+    private static void applyLabel(Program program, Address address, SymbolRow row) throws Exception {
+        String generated = generatedName(program, address);
+        SymbolTable symbols = program.getSymbolTable();
+        Symbol label = symbols.createLabel(address, row.name(), SourceType.USER_DEFINED);
+        label.setPrimary();
+        keepGeneratedName(program, address, generated);
+        setEolComment(program, address, row.comment());
+    }
+
+    private static void applyData(Program program, Address address, SymbolRow row) throws Exception {
+        String generated = generatedName(program, address);
+        if (!row.type().isEmpty()) {
+            DataType type = new DataTypeParser(program.getDataTypeManager(), null, null,
+                DataTypeParser.AllowedDataTypes.FIXED_LENGTH).parse(row.type());
+            Data data = DataUtilities.createData(program, address, type, -1,
+                DataUtilities.ClearDataMode.CLEAR_ALL_CONFLICT_DATA);
+            if (data == null) {
+                throw new IllegalArgumentException("data type cannot be applied: " + row.type());
+            }
+        }
+        Symbol label = program.getSymbolTable().createLabel(address, row.name(), SourceType.USER_DEFINED);
+        label.setPrimary();
+        keepGeneratedName(program, address, generated);
+        setEolComment(program, address, row.comment());
+    }
+
+    private static String generatedName(Program program, Address address) {
+        Symbol primary = program.getSymbolTable().getPrimarySymbol(address);
+        return primary != null && primary.getSource() == SourceType.DEFAULT ? primary.getName() : null;
+    }
+
+    /** Keep the name Ghidra generated as a secondary label next to the annotation. */
+    private static void keepGeneratedName(Program program, Address address, String generated)
+            throws Exception {
+        if (generated == null) {
+            return;
+        }
+        SymbolTable symbols = program.getSymbolTable();
+        if (symbols.getSymbol(generated, address, null) == null) {
+            symbols.createLabel(address, generated, SourceType.USER_DEFINED);
+        }
+        Symbol primary = symbols.getPrimarySymbol(address);
+        if (primary != null && primary.getName().equals(generated)) {
+            throw new IllegalStateException("annotation did not become the primary name");
+        }
+    }
+
+    private static void setEolComment(Program program, Address address, String comment) {
+        if (!comment.isEmpty()) {
+            program.getListing().setComment(address, CommentType.EOL, comment);
+        }
+    }
+}
