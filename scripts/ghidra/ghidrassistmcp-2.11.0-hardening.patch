+    private String getTypeLayout(String name, Program program) {
+        var types = program.getDataTypeManager().getAllDataTypes();
+        while (types.hasNext()) {
+            DataType type = types.next();
+            if (!type.getName().equals(name)) {
+                continue;
+            }
+            while (type instanceof ghidra.program.model.data.TypeDef alias) {
+                type = alias.getBaseDataType();
+            }
+            if (type instanceof ghidra.program.model.data.Composite composite) {
+                StringBuilder result = new StringBuilder();
+                result.append("TYPE\t").append(name).append("\t")
+                    .append(composite.getLength()).append("\t")
+                    .append(composite.getAlignment()).append("\n");
+                appendTypeFields(result, composite, name, 0, new HashSet<>());
+                return result.toString();
+            }
+        }
+        return null;
+    }
+
+    private void appendTypeFields(StringBuilder result,
+            ghidra.program.model.data.Composite composite, String path, int base,
+            Set<DataType> active) {
+        if (!active.add(composite)) {
+            return;
+        }
+        for (var field : composite.getDefinedComponents()) {
+            String name = field.getFieldName();
+            String key = path + "." + (name == null ? "<anonymous>" : name);
+            int offset = base + field.getOffset();
+            DataType type = field.getDataType();
+            result.append("FIELD\t").append(key).append("\t").append(offset)
+                .append("\t").append(field.getLength()).append("\t")
+                .append(type.getName()).append("\n");
+            while (type instanceof ghidra.program.model.data.TypeDef alias) {
+                type = alias.getBaseDataType();
+            }
+            if (type instanceof Array array) {
+                type = array.getDataType();
+                key += "[0]";
+            }
+            if (type instanceof ghidra.program.model.data.Composite nested) {
+                appendTypeFields(result, nested, key, offset, active);
+            }
+        }
+        active.remove(composite);
+    }
+
